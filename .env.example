# Environment für den Single-Container Go-App (docker-compose.single.yml).
# Nach .env kopieren und anpassen. Bis auf APP_KEY haben alle Werte sinnvolle
# Defaults; APP_KEY muss vor dem ersten Start selbst gesetzt werden.

# Host-Port, unter dem die App erreichbar ist
APP_PORT=3100

# Port innerhalb des Containers. Compose baut daraus Port-Mapping, HTTP_ADDR und
# Healthcheck - eine Quelle für alle drei. Normalerweise unverändert lassen; von
# außen zählt nur APP_PORT. Ohne HTTP_ADDR startet die App nicht (das Image setzt
# absichtlich keinen Default), deshalb muss dieser Wert gesetzt bleiben.
APP_CONTAINER_PORT=8080

# Schlüssel, aus dem die Plattform-Credentials verschlüsselt werden (HMAC-SHA256 →
# AES-256 pro Benutzer). Mindestens 32 zufällige Zeichen, nach oben offen.
# Pflichtfeld: ohne eigenen Wert startet die App nicht.
#   openssl rand -base64 32
# Ändern nach dem ersten Start macht alle gespeicherten Credentials unlesbar.
APP_KEY=

# true, wenn die App hinter einem HTTPS-Reverse-Proxy läuft (setzt Secure-Cookies)
APP_HTTPS=false

# Erlaubte CORS-Origin, z. B. https://meshdepot.example.com - leer = Request-Origin spiegeln
APP_URL=

# Logging-Level: none | error | warning | info | all
#   error   - nur harte Fehler (empfohlen für Produktion)
#   warning - Fehler + potenzielle Probleme (abgelaufene Tokens, leere Downloads)
#   info    - voller Trace aller Download-Schritte (Debugging)
#   all     - alles
LOG_LEVEL=error

# Basis-URL des Playwright/Firefox-Sidecars für MakerWorld-Downloads (CF-Bypass); leer = aus
PLAYWRIGHT_URL=

# Shared Secret für den Sidecar: App schickt es als Bearer-Token, der Sidecar lehnt
# ohne passenden Wert ab. Muss mit dem PLAYWRIGHT_TOKEN des Sidecars übereinstimmen.
# PFLICHT, sobald der Sidecar läuft - ohne Token startet er nicht (er nimmt
# Zugangsdaten entgegen und gibt Cookies im Klartext zurück).
# Erzeugen z. B. mit:  openssl rand -hex 32
PLAYWRIGHT_TOKEN=

# Zeitzone für Scheduler und Log-Timestamps
TZ=Europe/Berlin
