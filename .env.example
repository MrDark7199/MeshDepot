# Environment for the single-container Go app (docker-compose.yml).
# Copy to .env and adjust. Except for APP_KEY every value has a sensible
# default; APP_KEY must be set yourself before the first start.

# Port the app is reachable on. The container shares the host's network stack
# (network_mode: host in docker-compose.yml), so this is the port it binds on
# the host directly - there is no mapping and no separate container-side port.
# Compose derives both HTTP_ADDR and the healthcheck from it.
APP_PORT=9000

# The three services that run inside the container. Because it shares the host's
# network stack they bind on the host, on loopback only. Change one just when the
# port is already taken. Optional; the defaults are what Compose uses.
#RESOLVER_PORT=9001      # Firefox resolver for captcha-gated download URLs
#TOR_SOCKS_PORT=9002     # bundled Tor, SOCKS5 proxy (Printables downloads)
#TOR_CONTROL_PORT=9003   # bundled Tor, control port

# How long the MakerWorld resolver keeps its warm Firefox alive with no work,
# in milliseconds. Optional; default 900000 (15 minutes). Lower it to free the
# memory sooner, raise it if a long download queue keeps re-warming the browser.
#MAKERWORLD_IDLE_MS=900000

# Key the platform credentials are encrypted with (HMAC-SHA256 -> AES-256 per
# user). At least 32 random characters, no upper limit.
# Required: without your own value the app does not start.
#   openssl rand -base64 32
# Changing it after the first start makes all stored credentials unreadable.
APP_KEY=

# true when the app runs behind an HTTPS reverse proxy (sets Secure cookies)
APP_HTTPS=false

# Allowed CORS origin, e.g. https://meshdepot.example.com - empty = mirror the request origin
APP_URL=

# Logging level: none | error | warning | info | all
#   error   - hard errors only (recommended for production)
#   warning - errors + potential problems (expired tokens, empty downloads)
#   info    - full trace of all download steps (debugging)
#   all     - everything
LOG_LEVEL=error

# Base URL of the Playwright/Firefox sidecar for MakerWorld downloads (CF bypass); empty = off
PLAYWRIGHT_URL=

# Shared secret for the sidecar: the app sends it as a bearer token, and the
# sidecar rejects anything without the matching value. Must match the sidecar's
# PLAYWRIGHT_TOKEN. REQUIRED as soon as the sidecar runs - without a token it
# does not start (it takes credentials in and returns cookies in clear text).
# Generate e.g. with:  openssl rand -hex 32
PLAYWRIGHT_TOKEN=

# Time zone for the scheduler and log timestamps
TZ=Europe/Berlin
