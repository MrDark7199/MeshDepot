# Environment for the single-container Go app (docker-compose.single.yml).
# Copy to .env and adjust. Except for APP_KEY, every value has a sensible
# default; APP_KEY has to be set yourself before the first start.

# Host port the app is reachable on
APP_PORT=3100

# Port inside the container. Compose derives the port mapping, HTTP_ADDR and the
# healthcheck from it - one source for all three. Normally leave unchanged; from
# the outside only APP_PORT matters. Without HTTP_ADDR the app does not start
# (the image deliberately sets no default), so this value has to stay set.
APP_CONTAINER_PORT=8080

# Key the platform credentials are encrypted from (HMAC-SHA256 -> AES-256 per
# user). At least 32 random characters, no upper limit.
# Required: without your own value the app does not start.
#   openssl rand -base64 32
# Changing it after the first start makes all stored credentials unreadable.
APP_KEY=

# true if the app runs behind an HTTPS reverse proxy (enables secure cookies)
APP_HTTPS=false

# Allowed CORS origin, e.g. https://meshdepot.example.com - empty = mirror the request origin
APP_URL=

# Logging level: none | error | warning | info | all
#   error   - hard errors only (recommended for production)
#   warning - errors + potential problems (expired tokens, empty downloads)
#   info    - full trace of all download steps (debugging)
#   all     - everything
LOG_LEVEL=error

# Base URL of the Playwright/Firefox sidecar for MakerWorld downloads (CF bypass); empty = off
PLAYWRIGHT_URL=

# Shared secret for the sidecar: the app sends it as a bearer token, the sidecar
# rejects requests without a matching value. Must match the sidecar's
# PLAYWRIGHT_TOKEN. REQUIRED as soon as the sidecar runs - without a token it
# does not start (it accepts credentials and returns cookies in plaintext).
# Generate for example with:  openssl rand -hex 32
PLAYWRIGHT_TOKEN=

# Timezone for the scheduler and log timestamps
TZ=Europe/Berlin
