# Keep the build context small: the Dockerfile only copies frontend/ and
# backend/ sources plus the Firefox resolver under docker/playwright/. Large
# runtime/test directories are unnecessary and would otherwise blow the context
# up to several GB.
.git
**/node_modules
data/
backend/testdata/
# docker/ is excluded wholesale, then the two directories the image needs are
# allowed back in: stage 4 of backend/Dockerfile installs the resolver and
# unpacks the vendored Microsoft font archives (3.8 MB, so the context stays
# small).
docker/*
!docker/playwright
!docker/fonts
docs/
*.log
