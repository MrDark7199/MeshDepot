{
  "manifest_version": 3,
  "name": "MeshDepot Importer",
  "version": "0.2.0",
  "description": "Import the design you are looking at - MakerWorld, Printables, Thingiverse or MyMiniFactory - into your own MeshDepot.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "cookies",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://makerworld.com/*",
    "https://*.makerworld.com/*",
    "https://www.printables.com/*",
    "https://printables.com/*",
    "https://www.thingiverse.com/*",
    "https://thingiverse.com/*",
    "https://www.myminifactory.com/*",
    "https://myminifactory.com/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*",
        "https://www.printables.com/*",
        "https://printables.com/*",
        "https://www.thingiverse.com/*",
        "https://thingiverse.com/*",
        "https://www.myminifactory.com/*",
        "https://myminifactory.com/*"
      ],
      "js": [
        "compat.js",
        "platforms.js",
        "bridge.js",
        "panel.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "page.js",
        "platforms.js"
      ],
      "matches": [
        "https://makerworld.com/*",
        "https://*.makerworld.com/*",
        "https://www.printables.com/*",
        "https://printables.com/*",
        "https://www.thingiverse.com/*",
        "https://thingiverse.com/*",
        "https://www.myminifactory.com/*",
        "https://myminifactory.com/*"
      ]
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "MeshDepot Importer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "options.html"
  },
  "background": {
    "service_worker": "sw.js"
  }
}
